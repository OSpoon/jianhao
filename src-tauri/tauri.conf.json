{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jianhao",
  "version": "0.1.0",
  "identifier": "com.osp.jianhao",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "渐好 · Jianhao",
        "width": 460,
        "height": 760,
        "minWidth": 460,
        "maxWidth": 460,
        "minHeight": 760,
        "maxHeight": 760,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQzZFOTkyRkU4MDQxRUEKUldUcVFZRCtrdW5HTUdTNk1MSTZVcDBGaXk1cml3Y1pKV3lnZTVkelBHYmV3bVhGajJGVkhOQWUK",
      "endpoints": [
        "https://github.com/OSpoon/jianhao/releases/latest/download/latest.json"
      ]
    }
  }
}
