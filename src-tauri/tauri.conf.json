{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jianhao",
  "version": "0.1.1-beta.3",
  "identifier": "com.osp.jianhao",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "渐好 · 坐姿提醒",
        "width": 360,
        "height": 203,
        "minWidth": 210,
        "minHeight": 180,
        "resizable": false,
        "visible": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "OSpoon",
    "copyright": "Copyright (c) 2026 OSpoon",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "本机运行的实时坐姿提醒桌面应用",
    "longDescription": "渐好通过摄像头在本机实时分析坐姿；需要调整时，整个窗口会出现柔和的半透明红黄渐变提醒遮罩。摄像头画面不会上传。",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2MEY1Q0M4MTRGMTc2OTIKUldTU2R2RVV5RndQTnYvZFkyeTFCOGtBSHhMeGR6d2xpQVdFcUdZdzI2V3pTM3FzZkwwMHdwcy8K",
      "endpoints": [
        "https://github.com/OSpoon/jianhao/releases/latest/download/latest.json"
      ]
    }
  }
}
