{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "x-apple.systempreferences:com.apple.settings.PrivacySecurity.extension[?]Privacy_Camera" },
        { "url": "x-apple.systempreferences:com.apple.Notifications-Settings.extension[?]id=com.osp.jianhao" }
      ]
    },
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "log:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPLOG" }]
    }
  ]
}
