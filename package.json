{
  "name": "jianhao",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.15.0",
    "pnpm": "10.15.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "pnpm lint:fix && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "pnpm lint && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "release": "bumpp",
    "version": "changelogen --output CHANGELOG.md",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.47.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@tanstack/vue-table": "^9.2.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.12",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "bumpp": "^10.4.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.11.0",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "eslint --fix",
    "*.rs": "rustfmt --edition 2021"
  }
}
